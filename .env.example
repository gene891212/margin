DATABASE_FILE=./data/app.sqlite
DATA_DIR=./data
API_PORT=4100
WEB_ORIGIN=http://127.0.0.1:5173
# 翻譯模型設定（有設定 OPENAI_MODEL 時自動啟用真實模型；未設定或 TRANSLATION_PROVIDER=mock 則走免額度示範模式）
# TRANSLATION_PROVIDER=auto

# 範例 1 - OpenAI 官方:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# 範例 2 - 本地 Ollama (免金鑰、完全離線):
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_MODEL=qwen2.5:14b
#
# 範例 3 - Google Gemini (官方相容層):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=你的GoogleAI金鑰
# OPENAI_MODEL=gemini-1.5-flash

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
MAX_SOURCE_BYTES=5000000
MAX_TRANSLATION_CHARACTERS=120000
BROWSER_FALLBACK_ENABLED=true
BROWSER_TIMEOUT_MS=30000
BROWSER_EXECUTABLE_PATH=
